#!/usr/bin/env bash
set -uo pipefail

# Digest de um arquivo de sessão (sessions/NNNN-*.md): status, objetivo, escopo,
# critérios→teste (S1), nomes dos passos do plano TDD e fim do progresso.
# Substitui a leitura integral do arquivo quando só precisa do "o quê / quem / como
# testado" — ler o arquivo inteiro só em TDD/validação (fase 2/3), se necessário.

cd "$(dirname "$0")/.."

NUM="${1:-$(ls sessions/[0-9][0-9][0-9][0-9]-*.md 2>/dev/null | sort | tail -1 | xargs -n1 basename | cut -d- -f1)}"
F="$(ls sessions/"$NUM"-*.md 2>/dev/null | head -1)"
if [ -z "$F" ]; then
  echo "levantar-sessao> sessão $NUM não encontrada em sessions/" >&2
  exit 1
fi

short() { sed -E 's/(.{180}).*/\1…/'; }

echo "== $NUM — $(grep -m1 '^# Sessão' "$F" | sed -E 's/^# Sessão [0-9]{4} — //')"
echo

printf '## Status\n'
awk '/^## Status/{f=1; next} f && /^## [0-9]+\./{exit} f && $0 !~ /^\| *---/{print}' "$F" | short
printf '\n## Objetivo\n'
awk '/^## 1\. Objetivo/{f=1; next} f && /^## [0-9]+\./{exit} f && NF{print}' "$F" | short
printf '\n## Escopo (produção / fora de escopo)\n'
awk '/^## 3\. Escopo/{f=1; next} f && /^## [0-9]+\./{exit} f {
  if ($0 ~ /^### Produção/) print "### Produção (escopo implementado — ver tabela no arquivo se precisar)";
  else if ($0 ~ /^### Fora de escopo/) print "### Fora de escopo"; else if ($0 ~ /^[-*] /) print; }' "$F" | short | head -20
printf '\n## Critério → teste que o prova (S1)\n'
awk '/^#{3,5} .*(teste|Teste|prova)/{f=1; next} f && /^#{1,3} /{exit} f && NF{print}' "$F" | short | head -25
printf '\n## Plano TDD (passos)\n'
grep -E '(^#{3,5} Passo|^[-*] \*\*?Passo [0-9])' "$F" | short | head -30
printf '\n## Progresso (fase 2) e validação (fase 3) — fim\n'
awk 'f && /^## 8\./{exit} /### Progresso da implementação/{f=1} f{print}' "$F" | grep -v '^$' | tail -25 | short