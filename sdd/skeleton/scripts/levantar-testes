#!/usr/bin/env bash
set -uo pipefail

# Índice dos arquivos de teste do projeto + busca por nome/keyword.
# Ajuda a fechar o critério→teste (S1): achar o arquivo/nome do teste certo
# sem abrir vários arquivos.
#
# Ajuste TEST_DIR ao layout do projeto (ex.: test/, tests/, spec/, src/) — ver STACK.md.

cd "$(dirname "$0")/.."

TEST_DIR="${TEST_DIR:-test}"
SEARCH="${1:-}"

if [ ! -d "$TEST_DIR" ]; then
  echo "diretório de testes '$TEST_DIR' não existe — ajuste TEST_DIR ao layout do projeto (ver STACK.md)" >&2
  exit 0
fi

if [ -n "$SEARCH" ]; then
  echo "== testes com '$SEARCH' (arquivo:linha) =="
  rg -in "$SEARCH" "$TEST_DIR" | head -40
  echo
  echo "== arquivos que mencionam '$SEARCH' =="
  rg -il "$SEARCH" "$TEST_DIR" | head -15
else
  echo "== arquivos de teste ($TEST_DIR) =="
  find "$TEST_DIR" -type f 2>/dev/null | sort | while read -r f; do
    printf '%5s linhas  %s\n' "$(wc -l < "$f")" "$f"
  done | sort -rn
  echo
  echo "uso: ./scripts/levantar-testes [keyword] — filtra testes por nome/texto"
fi
