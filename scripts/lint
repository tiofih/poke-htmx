#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [ "$(docker compose ps --filter status=running --services | grep -c '^web$')" -eq 1 ]; then
  echo "w> Containerizando 'web' de pé — executando lint nele."
  docker compose exec -T web bundle exec rubocop "$@"
else
  echo "w> Container 'web' parado — executando one-off para o lint."
  docker compose run --rm web bundle exec rubocop "$@"
fi