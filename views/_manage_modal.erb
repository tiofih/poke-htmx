<div id="manage-modal" class="overlay open">
  <div class="modal" role="dialog" aria-modal="true" aria-label="Gerenciar Pokémon" data-od-id="modal-manage">
    <div class="modal-head">
      <h2>Gerenciar time</h2>
      <button type="button" class="modal-close" aria-label="Fechar" data-od-id="modal-manage-close"
         hx-get="/team/manage/close" hx-target="#manage-modal" hx-swap="outerHTML">×</button>
    </div>
    <%= erb :team_manage, layout: false, locals: { team: team, team_types: team_types, member_levels: member_levels, available_moves: available_moves, inventory: inventory, draft_moves: draft_moves, notice: notice, notice_kind: notice_kind } %>
  </div>
</div>
