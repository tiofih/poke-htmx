<% if @message %>
  <p class="notice notice--info"><%= @message %></p>
  <% if @gate_cta %>
    <a class="gameloop-cta" href="<%= @gate_cta[:href] %>"><%= @gate_cta[:label] %></a>
  <% end %>
  <% if @gate_action %>
    <form method="post" action="<%= @gate_action[:href] %>">
      <button type="submit" class="gameloop-cta"><%= @gate_action[:label] %></button>
    </form>
  <% end %>
  <% if @gate_disabled_cta %>
    <button class="gameloop-cta" disabled title="<%= @gate_disabled_cta[:title] %>"><%= @gate_disabled_cta[:label] %></button>
  <% end %>
<% elsif @engine %>
  <h1>Batalha</h1>

  <% juice = BattleJuicePresenter.new(
       log: @engine.log,
       final_hp: { 0 => @engine.teams[0].to_h { |poke| [poke.name, poke.hp_current] },
                   1 => @engine.teams[1].to_h { |poke| [poke.name, poke.hp_current] } }
     ) %>

  <div class="arena">
    <div class="battle-column" data-side="0" data-od-id="side-team">
      <div class="side-head"><h2>Seu Time</h2></div>
      <ul class="fighters">
        <%= erb :_fighter_panel, layout: false, locals: { title: "Seu Time", side: 0, juice: juice, presenters: @engine.teams[0].each_with_index.map { |poke, index| FighterPresenter.new(poke, item_used: @engine.member_used_item?(0, index)) } } %>
      </ul>

      <% unless @engine.items.empty? %>
        <p class="stock-items">Itens:
          <% @engine.items.each do |name, quantity| %>
            <% next unless quantity.to_i.positive? %>
            <%= ItemCatalog.find(name)&.display_name || name %> ×<%= quantity %>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="podium" data-od-id="controls">
      <div class="round-banner">
        <span class="turn-status">Rodada <%= @engine.rounds %><% if @engine.finished? %> — Fim de batalha<% end %></span>
      </div>
      <div class="controls">
        <% if @engine.finished? %>
        <% else %>
          <button class="btn btn-primary" hx-post="/battle/play" hx-target="#battle-view" hx-swap="innerHTML"
            hx-indicator="#battle-loading">Batalhar</button>
          <span id="battle-loading" class="battle-loading" aria-hidden="true">Carregando…</span>
        <% end %>
      </div>

      <div id="result-box">
        <% if @engine.finished? %>
          <% winner_name = @engine.winner.zero? ? "Seu Time" : "Oponente" %>
          <div class="result">
            <p class="winner-badge"><strong>Vencedor: <%= winner_name %></strong></p>
            <% if @xp_gained %>
              <p class="rewards"><strong>Seu Time ganhou <%= @xp_gained %> XP por Pokémon<%= @money_gained ? " e #{@money_gained} de dinheiro." : "." %></strong></p>
            <% end %>
            <% if defined?(@evolution_news) && !@evolution_news&.empty? %>
              <ul class="evolution-news news--pop">
                <% @evolution_news.each do |news| %>
                  <li><%= news %></li>
                <% end %>
              </ul>
            <% end %>
            <% if defined?(@learned_news) && !@learned_news&.empty? %>
              <ul class="learned-news news--pop">
                <% @learned_news.each do |news| %>
                  <li><%= news %></li>
                <% end %>
              </ul>
            <% end %>
            <% if @game_over %>
              <p class="notice notice--error">Game Over — seu time está derrotado e você não tem dinheiro para curar no Poke Center.</p>
              <div class="ctas">
                <a class="btn btn-secondary" href="/">Vender itens no Poke Mart</a>
                <form method="post" action="/journey/restart">
                  <button type="submit" class="btn btn-secondary">Recomeçar jornada</button>
                </form>
              </div>
            <% else %>
              <div class="ctas">
                <a class="btn btn-secondary" href="/">Poke Center</a>
                <a class="btn btn-secondary" href="/">Poke Mart</a>
                <% if @can_new_confront %>
                  <button class="btn btn-primary" hx-post="/battle/new" hx-target="#battle-view" hx-swap="innerHTML">Novo confronto</button>
                <% else %>
                  <button class="btn btn-secondary" disabled title="Recupere seus pokémons no Poke Center para batalhar.">Novo confronto</button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <% log_entries = BattleLogPresenter.new(@engine.log).entries_all %>
      <% unless log_entries.empty? %>
        <% round_order = log_entries.map { |entry| entry[:round] }.uniq.each_with_index.to_h %>
        <p class="log-title">Registro da batalha</p>
        <div class="battle-log">
          <ul class="log">
            <% log_entries.each do |entry| %>
              <% side_class = entry[:side] == "Seu Time" ? "team" : "opp" %>
              <li class="log__entry"
                  data-round="<%= entry[:round] %>"
                  data-from-side="<%= entry[:from_side] %>"
                  data-to-side="<%= entry[:to_side] %>"
                  style="--log-delay: <%= (round_order.size - 1 - round_order.fetch(entry[:round])) * 0.25 %>s">
                <span class="log-round">Rodada <%= entry[:round] %>:</span>
                <span class="lside <%= side_class %>"><%= entry[:side] %></span>
                <span class="txt"><strong><%= entry[:text] %></strong></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <div class="battle-column" data-side="1" data-od-id="side-opponent">
      <div class="side-head"><h2>Oponente</h2></div>
      <ul class="fighters">
        <%= erb :_fighter_panel, layout: false, locals: { title: "Oponente", side: 1, juice: juice, presenters: @engine.teams[1].map { |poke| FighterPresenter.new(poke) } } %>
      </ul>
    </div>
  </div>
<% end %>
