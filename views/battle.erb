<% if @message %>
  <p class="notice notice--info"><%= @message %></p>
  <% if @gate_cta %>
    <a class="gameloop-cta" href="<%= @gate_cta[:href] %>"><%= @gate_cta[:label] %></a>
  <% end %>
  <% if @gate_action %>
    <form method="post" action="<%= @gate_action[:href] %>">
      <button type="submit" class="gameloop-cta"><%= @gate_action[:label] %></button>
    </form>
  <% end %>
  <% if @gate_disabled_cta %>
    <button class="gameloop-cta" disabled title="<%= @gate_disabled_cta[:title] %>"><%= @gate_disabled_cta[:label] %></button>
  <% end %>
<% elsif @engine %>
  <h1>Batalha</h1>
  <p class="round">Rodada <%= @engine.rounds %><% if @engine.finished? %> — Fim de batalha<% end %></p>

  <div class="battle-layout">
    <div class="battle-column">
      <%= erb :_fighter_panel, layout: false, locals: { title: "Seu Time", presenters: @engine.teams[0].each_with_index.map { |poke, index| FighterPresenter.new(poke, item_used: @engine.member_used_item?(0, index)) } } %>

      <% unless @engine.items.empty? %>
        <p class="stock-items">Itens:
          <% @engine.items.each do |name, quantity| %>
            <% next unless quantity.to_i.positive? %>
            <%= ItemCatalog.find(name)&.display_name || name %> ×<%= quantity %>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="battle-column battle-center">
      <div class="battle-controls">
        <% if @engine.finished? %>
          <% winner_name = @engine.winner.zero? ? "Seu Time" : "Oponente" %>
          <p class="winner"><strong>Vencedor: <%= winner_name %></strong></p>
          <% if @xp_gained %>
            <p class="xp-gained"><strong>Seu Time ganhou <%= @xp_gained %> XP por Pokémon<%= @money_gained ? " e #{@money_gained} de dinheiro." : "." %></strong></p>
          <% end %>
          <% if defined?(@evolution_news) && !@evolution_news&.empty? %>
            <ul class="evolution-news">
              <% @evolution_news.each do |news| %>
                <li><%= news %></li>
              <% end %>
            </ul>
          <% end %>
          <% if defined?(@learned_news) && !@learned_news&.empty? %>
            <ul class="learned-news">
              <% @learned_news.each do |news| %>
                <li><%= news %></li>
              <% end %>
            </ul>
          <% end %>
          <% if @game_over %>
            <p class="notice notice--error">Game Over — seu time está derrotado e você não tem dinheiro para curar no Poke Center.</p>
            <div class="gameloop-ctas">
              <a class="gameloop-cta" href="/">Vender itens no Poke Mart</a>
              <form method="post" action="/journey/restart">
                <button type="submit" class="gameloop-cta">Recomeçar jornada</button>
              </form>
            </div>
          <% else %>
          <div class="gameloop-ctas">
            <a class="gameloop-cta" href="/">Poke Center</a>
            <a class="gameloop-cta" href="/">Poke Mart</a>
            <% if @can_new_confront %>
              <button class="gameloop-cta" hx-post="/battle/new" hx-target="#battle-view" hx-swap="innerHTML">Novo confronto</button>
            <% else %>
              <button class="gameloop-cta" disabled title="Recupere seus pokémons no Poke Center para batalhar.">Novo confronto</button>
            <% end %>
          </div>
          <% end %>
        <% else %>
          <button hx-post="/battle/play" hx-target="#battle-view" hx-swap="innerHTML"
            hx-indicator="#battle-loading">Jogar</button>
          <span id="battle-loading" class="battle-loading" aria-hidden="true">Carregando…</span>
        <% end %>
      </div>

      <% log_entries = BattleLogPresenter.new(@engine.log).entries %>
      <% unless log_entries.empty? %>
        <ul class="battle-log">
          <% log_entries.each do |entry| %>
            <li><span class="log-round">Rodada <%= entry[:round] %>:</span> <%= entry[:side] %>: <strong><%= entry[:text] %></strong></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="battle-column">
      <%= erb :_fighter_panel, layout: false, locals: { title: "Oponente", presenters: @engine.teams[1].map { |poke| FighterPresenter.new(poke) } } %>
    </div>
  </div>
<% end %>