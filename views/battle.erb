<% if @message %>
  <p class="notice notice--info"><%= @message %></p>
  <% if @gate_cta %>
    <a class="btn btn-secondary" href="<%= @gate_cta[:href] %>"><%= @gate_cta[:label] %></a>
  <% end %>
  <% if @gate_action %>
    <form method="post" action="<%= @gate_action[:href] %>">
      <button type="submit" class="btn btn-secondary"><%= @gate_action[:label] %></button>
    </form>
  <% end %>
  <% if @gate_disabled_cta %>
    <button class="btn btn-secondary" disabled title="<%= @gate_disabled_cta[:title] %>"><%= @gate_disabled_cta[:label] %></button>
  <% end %>
<% elsif @engine %>
  <h1>Batalha</h1>

  <% juice = BattleJuicePresenter.new(
       log: @engine.log,
       final_hp: { 0 => @engine.teams[0].to_h { |poke| [poke.name, poke.hp_current] },
                   1 => @engine.teams[1].to_h { |poke| [poke.name, poke.hp_current] } }
     ) %>

  <div class="arena">
    <div class="battle-column" data-side="0" data-od-id="side-team">
      <div class="side-head"><h2>Seu Time</h2><p class="meta"><%= @engine.teams[0].count { |fighter| !fighter.fainted? } %> ativos</p></div>
      <ul class="fighters">
        <%= erb :_fighter_panel, layout: false, locals: { title: "Seu Time", side: 0, juice: juice, presenters: @engine.teams[0].each_with_index.map { |poke, index| FighterPresenter.new(poke, item_used: @engine.member_used_item?(0, index)) } } %>
      </ul>

      <% unless @engine.items.empty? %>
        <p class="stock-items">Itens:
          <% @engine.items.each do |name, quantity| %>
            <% next unless quantity.to_i.positive? %>
            <%= ItemCatalog.find(name)&.display_name || name %> ×<%= quantity %>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="podium" data-od-id="controls">
      <div class="card">
      <div class="round-banner">
        <span class="turn-status">Rodada <%= @engine.rounds %><% if @engine.finished? %> — Fim de batalha<% end %></span>
      </div>
      <div class="controls">
        <% if @engine.finished? %>
        <% else %>
          <button class="btn btn-primary btn-lg" id="play-btn" data-od-id="cta-play" hx-post="/battle/play" hx-target="#battle-view" hx-swap="innerHTML"
            hx-indicator="#battle-loading">Batalhar</button>
          <span id="battle-loading" class="battle-loading" aria-hidden="true">Carregando…</span>
        <% end %>
      </div>

      <div id="result-box">
        <% if @engine.finished? %>
          <% end_state = @game_over ? "over" : (@engine.winner.nil? ? "draw" : (@engine.winner.zero? ? "win" : "loss")) %>
          <% end_slug, end_label, end_title = { "win" => ["victory", "Vitória", "Seu Time venceu"], "loss" => ["defeat", "Derrota", "Oponente venceu"], "draw" => ["draw", "Empate", "Empate — ninguém venceu"], "over" => ["gameover", "Game Over", "Sem dinheiro para curar"] }.fetch(end_state) %>
          <% winner_name = @engine.winner.nil? ? nil : (@engine.winner.zero? ? "Seu Time" : "Oponente") %>
          <div class="res-screen" data-od-id="res-<%= end_slug %>">
            <div class="res-top">
              <div class="res-top-left">
                <span class="state-pill <%= end_state %>"><%= end_label %></span>
                <div class="state-title"><h2><%= winner_name ? "Vencedor: #{winner_name}" : end_title %></h2></div>
              </div>
            </div>
            <section class="state-card" data-od-id="end-<%= end_slug %>">
              <div class="state-head"><span class="state-pill <%= end_state %>"><%= end_label %></span><h2><%= end_title %></h2></div>
              <div class="mini-arena">
                <% [["Seu Time", 0], ["Oponente", 1]].each do |side_name, side| %>
                  <div>
                    <div class="mini-side-title"><%= side_name %><%= " · derrotado" if @engine.teams[side].none? { |fighter| !fighter.fainted? } %></div>
                    <ul class="fighter-rows">
                      <% @engine.teams[side].each do |poke| %>
                        <% fighter = FighterPresenter.new(poke) %>
                        <% hp_fill = { high: "ok", medium: "warn", low: "danger" }.fetch(fighter.hp_tier, "ok") %>
                        <li class="frow<%= " lost" if fighter.hp_percent.zero? %>">
                          <span class="th"><img src="<%= fighter.sprite %>" alt="<%= fighter.alt %>"></span>
                          <span class="fid"><span class="fn"><%= fighter.name %><span class="ft"><% fighter.types.each do |tag| %><span class="ftg" style="background:var(--t-<%= tag %>)"><%= tag %></span><% end %></span></span></span>
                          <span class="hp"><span class="bg"><span class="fill" style="width:<%= fighter.hp_percent %>%;background:var(--<%= hp_fill %>)"></span></span><span class="lbl"><%= fighter.hp_label %></span></span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              </div>
              <div class="result-card">
          <div class="result">
            <% if winner_name %>
              <p class="winner-badge"><strong>Vencedor: <%= winner_name %></strong></p>
            <% else %>
              <p class="winner-badge"><strong><%= end_title %></strong></p>
            <% end %>
            <% if @xp_gained %>
              <p class="rewards"><strong>Seu Time ganhou <%= @xp_gained %> XP por Pokémon<%= @money_gained ? " e #{@money_gained} de dinheiro." : "." %></strong></p>
            <% end %>
            <% if defined?(@evolution_news) && !@evolution_news&.empty? %>
              <ul class="evolution-news news--pop">
                <% @evolution_news.each do |news| %>
                  <li><%= news %></li>
                <% end %>
              </ul>
            <% end %>
            <% if defined?(@learned_news) && !@learned_news&.empty? %>
              <ul class="learned-news news--pop">
                <% @learned_news.each do |news| %>
                  <li><%= news %></li>
                <% end %>
              </ul>
            <% end %>
            <% if @game_over %>
              <p class="notice notice--error">Game Over — seu time está derrotado e você não tem dinheiro para curar no Poke Center.</p>
              <div class="ctas">
                <a class="btn btn-secondary" href="#mart-modal" data-od-id="open-modal-mart" hx-get="/team/mart" hx-target="body" hx-swap="beforeend">Vender itens no Poke Mart</a>
                <form method="post" action="/journey/restart">
                  <button type="submit" class="btn btn-secondary">Recomeçar jornada</button>
                </form>
              </div>
            <% elsif end_state == "loss" %>
              <p class="rewards">Seu time foi derrotado. <strong>Cure no Poke Center</strong> ou recomece.</p>
              <div class="ctas">
                <a class="btn btn-primary" href="#center-modal" data-od-id="open-modal-center" hx-get="/team/center" hx-target="body" hx-swap="beforeend">Poke Center</a>
                <% if @can_new_confront %>
                  <button class="btn btn-primary" hx-post="/battle/new" hx-target="#battle-view" hx-swap="innerHTML">Novo confronto</button>
                <% else %>
                  <button class="btn btn-secondary" disabled title="Recupere seus pokémons no Poke Center para batalhar.">Novo confronto</button>
                <% end %>
                <form method="post" action="/journey/restart">
                  <button type="submit" class="btn btn-ghost">Recomeçar jornada</button>
                </form>
              </div>
            <% else %>
              <div class="ctas">
                <a class="btn btn-secondary" href="#center-modal" data-od-id="open-modal-center" hx-get="/team/center" hx-target="body" hx-swap="beforeend">Poke Center</a>
                <a class="btn btn-secondary" href="#mart-modal" data-od-id="open-modal-mart" hx-get="/team/mart" hx-target="body" hx-swap="beforeend">Poke Mart</a>
                <% if @can_new_confront %>
                  <button class="btn btn-primary" hx-post="/battle/new" hx-target="#battle-view" hx-swap="innerHTML">Novo confronto</button>
                <% else %>
                  <button class="btn btn-secondary" disabled title="Recupere seus pokémons no Poke Center para batalhar.">Novo confronto</button>
                <% end %>
              </div>
            <% end %>
              </div>
            </section>
          </div>
        <% end %>
      </div>
      </div>

      <% log_entries = BattleLogPresenter.new(@engine.log).entries_all %>
      <% unless log_entries.empty? %>
        <% round_order = log_entries.map { |entry| entry[:round] }.uniq.each_with_index.to_h %>
        <div class="log-title">Registro da batalha</div>
        <div class="battle-log">
          <ul class="log" id="battle-log">
            <% log_entries.each do |entry| %>
              <% side_class = entry[:side] == "Seu Time" ? "team" : "opp" %>
              <li class="log__entry"
                  data-round="<%= entry[:round] %>"
                  data-from-side="<%= entry[:from_side] %>"
                  data-to-side="<%= entry[:to_side] %>"
                  style="--log-delay: <%= (round_order.size - 1 - round_order.fetch(entry[:round])) * 0.25 %>s">
                <span class="log-round">Rodada <%= entry[:round] %>:</span>
                <span class="lside <%= side_class %>"><%= entry[:side] %></span>
                <span class="txt"><strong><%= entry[:text] %></strong></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <div class="battle-column" data-side="1" data-od-id="side-opponent">
      <div class="side-head"><h2>Oponente</h2><p class="meta"><%= @engine.teams[1].count { |fighter| !fighter.fainted? } %> ativos</p></div>
      <ul class="fighters">
        <%= erb :_fighter_panel, layout: false, locals: { title: "Oponente", side: 1, juice: juice, presenters: @engine.teams[1].map { |poke| FighterPresenter.new(poke) } } %>
      </ul>
    </div>
  </div>
<% end %>
