<% if @message %>
  <p class="notice notice--info"><%= @message %></p>
<% elsif @engine %>
  <h1>Batalha</h1>
  <p class="round">Rodada <%= @engine.rounds %><% if @engine.finished? %> — Fim de batalha<% end %></p>

  <%= erb :_fighter_panel, layout: false, locals: { title: "Seu Time", presenters: @engine.teams[0].map { |poke| FighterPresenter.new(poke) } } %>

  <% unless @engine.items.empty? %>
    <p class="stock-items">Itens:
      <% @engine.items.each do |name, quantity| %>
        <% next unless quantity.to_i.positive? %>
        <%= ItemCatalog.find(name)&.display_name || name %> ×<%= quantity %>
      <% end %>
    </p>
  <% end %>

  <%= erb :_fighter_panel, layout: false, locals: { title: "Oponente", presenters: @engine.teams[1].map { |poke| FighterPresenter.new(poke) } } %>

  <% last_round = @engine.log.select { |entry| entry[:round] == @engine.rounds } %>
  <% unless last_round.empty? %>
    <ul class="battle-log">
      <% last_round.each do |entry| %>
        <% if entry[:action] == :item %>
          <% display = ItemCatalog.find(entry[:item])&.display_name || entry[:item] %>
          <li>Seu Time: <strong><%= entry[:attacker_name] %></strong> usou <%= display %>, +<%= entry[:healed] %> HP</li>
        <% else %>
          <% attacker_side = entry[:attacker].zero? ? "Seu Time" : "Oponente" %>
          <li><%= attacker_side %>: <strong><%= entry[:attacker_name] %></strong> usou <%= entry[:move] || entry[:move_type] %> em <strong><%= entry[:target_name] %></strong>, <%= entry[:damage] %> de dano<%= entry[:ko] ? " — KO!" : "" %></li>
        <% end %>
      <% end %>
    </ul>
  <% end %>

  <% if @engine.finished? %>
    <% winner_name = @engine.winner.zero? ? "Seu Time" : "Oponente" %>
    <p class="winner"><strong>Vencedor: <%= winner_name %></strong></p>
    <% if @xp_gained %>
      <p class="xp-gained"><strong>Seu Time ganhou <%= @xp_gained %> XP por Pokémon<%= @money_gained ? " e #{@money_gained} de dinheiro." : "." %></strong></p>
    <% end %>
    <% if defined?(@evolution_news) && !@evolution_news&.empty? %>
      <ul class="evolution-news">
        <% @evolution_news.each do |news| %>
          <li><%= news %></li>
        <% end %>
      </ul>
    <% end %>
    <% if defined?(@learned_news) && !@learned_news&.empty? %>
      <ul class="learned-news">
        <% @learned_news.each do |news| %>
          <li><%= news %></li>
        <% end %>
      </ul>
    <% end %>
    <button hx-get="/battle" hx-target="#battle-view" hx-swap="innerHTML">Novo confronto</button>
  <% else %>
    <button hx-post="/battle/play" hx-target="#battle-view" hx-swap="innerHTML">Jogar</button>
  <% end %>
<% end %>