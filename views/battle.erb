<% if @message %>
  <p class="notice"><%= @message %></p>
<% elsif @engine %>
  <h1>Batalha</h1>
  <p class="round">Rodada <%= @engine.rounds %><% if @engine.finished? %> — Fim de batalha<% end %></p>

  <div class="battle-pane">
    <h2>Seu Time</h2>
    <% @engine.teams[0].each do |poke| %>
      <p class="fighter">
        <img src="<%= poke.sprite %>" alt="<%= poke.name %>">
        <%= poke.name %> — Nível <%= poke.level %> — HP <%= poke.hp_current %>/<%= poke.hp_max %>
      </p>
      <% unless poke.moves.empty? %>
        <ul class="moves">
          <% poke.moves.each do |move| %>
            <li><%= move.name %> — <span class="pp">PP <%= move.pp %></span></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>

  <div class="battle-pane">
    <h2>Oponente</h2>
    <% @engine.teams[1].each do |poke| %>
      <p class="fighter">
        <img src="<%= poke.sprite %>" alt="<%= poke.name %>">
        <%= poke.name %> — Nível <%= poke.level %> — HP <%= poke.hp_current %>/<%= poke.hp_max %>
      </p>
      <% unless poke.moves.empty? %>
        <ul class="moves">
          <% poke.moves.each do |move| %>
            <li><%= move.name %> — <span class="pp">PP <%= move.pp %></span></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>

  <% last_round = @engine.log.select { |entry| entry[:round] == @engine.rounds } %>
  <% unless last_round.empty? %>
    <ul class="battle-log">
      <% last_round.each do |entry| %>
        <% attacker_side = entry[:attacker].zero? ? "Seu Time" : "Oponente" %>
        <li><%= attacker_side %>: <strong><%= entry[:attacker_name] %></strong> usou <%= entry[:move] || entry[:move_type] %> em <strong><%= entry[:target_name] %></strong>, <%= entry[:damage] %> de dano<%= entry[:ko] ? " — KO!" : "" %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @engine.finished? %>
    <% winner_name = @engine.winner.zero? ? "Seu Time" : "Oponente" %>
    <p class="winner"><strong>Vencedor: <%= winner_name %></strong></p>
    <% if @xp_gained %>
      <p class="xp-gained"><strong>Seu Time ganhou <%= @xp_gained %> XP por Pokémon.</strong></p>
    <% end %>
    <% if defined?(@evolution_news) && !@evolution_news&.empty? %>
      <ul class="evolution-news">
        <% @evolution_news.each do |news| %>
          <li><%= news %></li>
        <% end %>
      </ul>
    <% end %>
    <% if defined?(@learned_news) && !@learned_news&.empty? %>
      <ul class="learned-news">
        <% @learned_news.each do |news| %>
          <li><%= news %></li>
        <% end %>
      </ul>
    <% end %>
    <button hx-get="/battle" hx-target="#battle" hx-swap="innerHTML">Novo confronto</button>
  <% else %>
    <button hx-post="/battle/play" hx-target="#battle" hx-swap="innerHTML">Jogar</button>
  <% end %>
<% end %>