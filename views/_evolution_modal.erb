<div id="evolution-modal" class="evolution-overlay overlay open" data-od-id="modal-evolution" role="dialog" aria-modal="true" aria-labelledby="evolution-modal-title">
  <div class="evolution-modal-box">
    <div class="evolution-modal-header">
      <h2 id="evolution-modal-title">Evoluir <%= @member.name %></h2>
      <button type="button" class="evolution-modal-close" aria-label="Fechar" data-od-id="modal-evolution-close"
              hx-get="/team/<%= @member.id %>/evolution/close"
              hx-target="#evolution-modal" hx-swap="outerHTML">×</button>
    </div>
    <% if @notice %>
      <p class="notice notice--<%= @notice_kind %>"><%= @notice %></p>
    <% end %>
    <% if @evolutions.any? %>
      <% @evolutions.each do |evo| %>
        <% item = ItemCatalog.find(evo[:item]) %>
        <% qty = @inventory_qty.fetch(evo[:item], 0) %>
        <div class="evolution-row">
          <span class="evolution-target"><%= item&.display_name || evo[:item] %> → <%= evo[:name] %></span>
          <span class="evolution-qty">Inventário: <%= qty %>×</span>
          <form hx-post="/team/<%= @member.id %>/evolve" hx-target="#evolution-modal" hx-swap="outerHTML">
            <input type="hidden" name="item_name" value="<%= evo[:item] %>">
            <button type="submit" class="btn"<%= " disabled" if qty.zero? %> >Evoluir</button>
          </form>
        </div>
      <% end %>
    <% else %>
      <p class="evolution-empty">Nenhuma evolução por pedra disponível para <%= @member.name %>.</p>
    <% end %>
  </div>
</div>