<% if @notice %>
  <p class="notice"><%= @notice %></p>
<% end %>
<select name="name" id="pokemons" hx-target="#pokemon" hx-trigger="change" hx-get="/pokemon">
  <option value="..." selected disabled>...</option>
  <% @page[:names].each do |pokemon_name| %>
    <option value="<%= pokemon_name %>"><%= pokemon_name %></option>
  <% end %>
</select>
<div class="pagination">
  <% if @offset.positive? %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset - 100 %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Anterior</a>
  <% end %>
  Página <%= (@offset / 100) + 1 %> de <%= (@page[:total].to_f / 100).ceil %>
  <% if (@offset + 100) < @page[:total] %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset + 100 %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Próxima</a>
  <% end %>
</div>