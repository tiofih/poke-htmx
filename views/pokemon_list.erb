<% if @notice %>
  <p class="notice"><%= @notice %></p>
<% end %>
<% unless @starters.empty? %>
  <h2 class="starters-title">Iniciais</h2>
  <ul class="pokemon-list starters">
    <% @starters.each do |name, pokemon| %>
      <%= erb :pokemon_list_item, layout: false, locals: { name: name, pokemon: pokemon, css_class: "starter-item" } %>
    <% end %>
  </ul>
<% end %>
<ul class="pokemon-list">
  <% @items.each do |name, pokemon| %>
    <%= erb :pokemon_list_item, layout: false, locals: { name: name, pokemon: pokemon, css_class: "list-item" } %>
  <% end %>
</ul>
<div class="pagination">
  <% if @offset.positive? %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset - @limit %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Anterior</a>
  <% end %>
  Página <%= (@offset / @limit) + 1 %> de <%= (@page[:total].to_f / @limit).ceil %>
  <% if (@offset + @limit) < @page[:total] %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset + @limit %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Próxima</a>
  <% end %>
</div>
