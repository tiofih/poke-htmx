<% if @notice %>
  <p class="notice"><%= @notice %></p>
<% end %>
<ul class="pokemon-list">
  <% @items.each do |name, pokemon| %>
    <li class="list-item">
      <% if pokemon %>
        <a href="#" hx-get="/pokemon/<%= pokemon.number %>" hx-target="#pokemon" hx-swap="innerHTML">
          <img src="<%= pokemon.sprite %>" alt="<%= name %>">
          <%= name %>
        </a>
      <% else %>
        <span><%= name %></span>
      <% end %>
      <form hx-post="/team" hx-target="#team" hx-swap="innerHTML">
        <input type="hidden" name="pokeName" value="<%= name %>">
        <button type="submit" class="btn">Add to Team</button>
      </form>
    </li>
  <% end %>
</ul>
<div class="pagination">
  <% if @offset.positive? %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset - @limit %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Anterior</a>
  <% end %>
  Página <%= (@offset / @limit) + 1 %> de <%= (@page[:total].to_f / @limit).ceil %>
  <% if (@offset + @limit) < @page[:total] %>
    <a href="#" hx-get="/pokemons?offset=<%= @offset + @limit %>&q=<%= @q %>" hx-target="#pokemon-list" hx-swap="innerHTML">Próxima</a>
  <% end %>
</div>
