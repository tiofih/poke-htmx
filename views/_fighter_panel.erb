<% lead_index = presenters.index { |f| !juice.fighter_juice(side, f.name)[:ko] } %>
<% step_pause = (defined?(side_delay) && side_delay ? side_delay.fetch(side, 0).to_f : 0.0).round(2) %>
<% presenters.each_with_index do |fighter, idx| %>
<% juice_data = juice.fighter_juice(side, fighter.name) %>
<% max_hp = fighter.hp_label.split("/").last.to_i %>
<% initial_percent = max_hp.positive? ? ((juice_data[:initial_hp].to_f / max_hp) * 100).round : 0 %>
<% hp_fill = { high: "ok", medium: "mid", low: "low" }.fetch(fighter.hp_tier, "ok") %>
  <li class="fighter<% juice.css_classes(side, fighter.name).each do |klass| %> <%= klass %><% end %><%= " engaged" if idx == lead_index && !juice_data[:ko] %>"
     data-side="<%= side %>"
     data-od-id="fighter-<%= fighter.name.downcase %>"
     data-hp-initial="<%= juice_data[:initial_hp] %>"
     data-damage="<%= juice_data[:damage_taken] %>"
     style="--step-delay: <%= step_pause %>s">
    <div class="fighter-head">
      <span class="sprite-tile"><img src="<%= fighter.sprite %>" alt="<%= fighter.alt %>" width="96" height="96"></span>
      <div class="fighter-id">
        <span class="fname"><%= fighter.name %></span>
        <div class="fmeta">
          <span class="lvl num">Nível <%= fighter.level %></span>
          <% badges = [] %>
          <% badges << fighter.item_used_badge unless fighter.item_used_badge.nil? %>
          <% badges << "carrega: #{fighter.assigned_item_label}" unless fighter.assigned_item_label.nil? %>
          <% badges << "segura: #{fighter.held_item_label}" unless fighter.held_item_label.nil? %>
          <% fighter_types = fighter.types.to_a %>
          <% unless badges.empty? && fighter_types.empty? %>
            <span class="ftags">
              <% badges.each do |badge| %><span class="ftag"><%= badge %></span><% end %>
              <% fighter_types.each do |tag| %><span class="ftag ftag--<%= tag %>"><%= tag %></span><% end %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="hp">
      <span class="hp-label">HP</span>
      <div class="bar" role="progressbar"
           aria-valuenow="<%= fighter.hp_label.split("/").first.to_i %>" aria-valuemin="0" aria-valuemax="<%= max_hp %>"
           aria-valuetext="HP <%= fighter.hp_label %>"
           style="--hp-initial-percent: <%= initial_percent %>%">
        <span class="bar-fill <%= hp_fill %>" style="width: <%= fighter.hp_percent %>%"></span>
      </div>
      <span class="num hp-val">HP <%= fighter.hp_label %></span>
    </div>
    <% unless fighter.moves.empty? %>
      <ul class="moves">
        <% fighter.moves.each do |move| %>
          <% pp_dot = { high: "ok", medium: "mid", low: "low" }.fetch(move.pp_tier, "ok") %>
          <li class="move">
            <span class="dot <%= pp_dot %>" aria-hidden="true"></span>
            <%= move.name %> · <span class="ppnum">PP <%= move.pp_current %>/<%= move.pp_max %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </li>
<% end %>
