<% if @notice %>
  <p class="notice"><%= @notice %></p>
<% end %>
<h1>Gerenciar time</h1>
<% @team.each do |poke| %>
  <div class="manage-member">
    <p class="slot">#<%= poke.slot %></p>
    <a href="#" hx-get="/pokemon/<%= poke.number %>" hx-target="#team" hx-swap="innerHTML">
      <img src="<%= poke.sprite %>">
    </a><br>
    <strong><%= poke.name %></strong><br>
    <form
        hx-post="/team/<%= poke.id %>/moves"
        hx-target="#team"
        hx-swap="innerHTML">
      <% @available_moves[poke.id].to_a.each do |move_name| %>
        <label>
          <input
            type="checkbox"
            name="moves"
            value="<%= move_name %>"<%= poke.moves.include?(move_name) ? " checked" : "" %>>
          <%= move_name %>
        </label><br>
      <% end %>
      <button type="submit">Salvar golpes</button>
    </form>
    <form
        hx-post="/team/<%= poke.id %>/item"
        hx-target="#team"
        hx-swap="innerHTML">
      <label>
        Item:
        <select name="item_name">
          <option value=""<%= poke.assigned_item.to_s.empty? ? " selected" : "" %>>Nenhum</option>
          <% @inventory.to_a.each do |entry| %>
            <% item = ItemCatalog.find(entry[:name]) %>
            <% next unless item && item.heal_amount.to_i.positive? %>
            <option value="<%= item.name %>"<%= poke.assigned_item == item.name ? " selected" : "" %>>
              <%= item.display_name %> ×<%= entry[:quantity] %>
            </option>
          <% end %>
        </select>
      </label>
      <button type="submit">Salvar item</button>
    </form>
    <form
        hx-post="/team/<%= poke.id %>/held-item"
        hx-target="#team"
        hx-swap="innerHTML">
      <label>
        Segurável:
        <select name="item_name">
          <option value=""<%= poke.held_item.to_s.empty? ? " selected" : "" %>>Nenhum</option>
          <% @inventory.to_a.each do |entry| %>
            <% item = ItemCatalog.find(entry[:name]) %>
            <% next unless item && item.category == "held" %>
            <option value="<%= item.name %>"<%= poke.held_item == item.name ? " selected" : "" %>>
              <%= item.display_name %> ×<%= entry[:quantity] %>
            </option>
          <% end %>
        </select>
      </label>
      <button type="submit">Salvar segurável</button>
    </form>
    <form
        hx-post="/team/<%= poke.id %>/move"
        hx-target="#team"
        hx-swap="innerHTML">
      <input type="hidden" name="new_slot" value="<%= poke.slot - 1 %>">
      <button type="submit">▲</button>
    </form>
    <form
        hx-post="/team/<%= poke.id %>/move"
        hx-target="#team"
        hx-swap="innerHTML">
      <input type="hidden" name="new_slot" value="<%= poke.slot + 1 %>">
      <button type="submit">▼</button>
    </form>
  </div>
<% end %>
<a href="#" hx-get="/team" hx-target="#team" hx-swap="innerHTML">Voltar</a>