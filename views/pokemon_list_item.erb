<li class="pcard">
  <% if pokemon %>
    <a href="#" hx-get="/pokemon/<%= pokemon.number %>" hx-target="#pokemon-detail" hx-swap="innerHTML">
      <img src="<%= pokemon.sprite %>" alt="<%= name %>" loading="lazy">
      <%= name %>
    </a>
    <% info = @pokemon_costs && @pokemon_costs[name] %>
    <% if info %>
      <span class="poke-cost<%= ' poke-cost--restricted' if info[:restricted] %>" data-tier="<%= info[:tier] %>"><%= info[:tier] %> · <%= info[:cost] %><%= ' ◆' if info[:restricted] %></span>
    <% end %>
  <% else %>
    <span><%= name %></span>
  <% end %>
  <form hx-post="/team" hx-target="#add-status" hx-swap="innerHTML" hx-include=".list-state">
    <input type="hidden" name="pokeName" value="<%= name %>">
    <%
      in_team = Array(@team_names).include?(name)
      disabled = in_team || @team_full
    %>
    <button type="submit" class="btn pcard-add" <%= 'disabled="disabled"' if disabled %>>
      <%= in_team ? "No time ✓" : "Adicionar ao time" %>
    </button>
  </form>
</li>