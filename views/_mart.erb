<h2>Poke Mart</h2>
<p class="balance">Saldo: <%= @balance %></p>
<% @catalog.each do |item| %>
  <form hx-post="/mart/buy" hx-target="#team-view" hx-swap="innerHTML">
    <input type="hidden" name="item_name" value="<%= item.name %>">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="btn"><%= item.display_name %> — <%= item.price %></button>
  </form>
<% end %>
<% if @inventory.any? %>
  <ul class="inventory">
    <% @inventory.each do |entry| %>
      <li><strong><%= entry[:name] %></strong> — <%= entry[:quantity] %>×</li>
    <% end %>
  </ul>
<% end %>