<p class="modal-sub">Compre itens ou venda do seu estoque. <span class="num">Saldo: ¥<%= balance %></span></p>
<input class="mart-tab-input" type="radio" name="mart-tab" id="mart-tab-buy" checked>
<input class="mart-tab-input" type="radio" name="mart-tab" id="mart-tab-sell">
<div class="tabs" role="tablist">
  <label class="tab tab-buy" for="mart-tab-buy" role="tab">Comprar</label>
  <label class="tab tab-sell" for="mart-tab-sell" role="tab">Vender</label>
</div>
<div class="tab-panel" id="tab-buy" role="tabpanel">
  <ul class="mart">
    <% catalog.each do |item| %>
      <% next if item.category == "stone" && !rotation.include?(item.name) %>
      <% affordable = balance / item.price %>
      <li>
        <span class="mart-name"><span class="item-icon" aria-hidden="true"><%= item.display_name[0] %></span><span><%= item.display_name %></span></span>
        <span class="row">
          <% if item.heal_amount.to_i.positive? %>
            <span class="meta">+<%= item.heal_amount %> HP · <%= format("%.1f", item.price.to_f / item.heal_amount) %> ¥/HP</span>
          <% end %>
          <span class="num price">¥<%= item.price %></span>
          <form hx-post="/mart/buy" hx-target="#team-view" hx-swap="innerHTML">
            <input type="hidden" name="item_name" value="<%= item.name %>">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn-secondary btn-sm"<%= " disabled" if affordable.zero? %>>Comprar ×<%= affordable %></button>
          </form>
        </span>
      </li>
    <% end %>
  </ul>
  <% out_rotation = catalog.select { |item| item.category == "stone" && !rotation.include?(item.name) } %>
  <% if out_rotation.any? %>
    <p class="meta">Fora da oferta desta rodada: <%= out_rotation.map(&:display_name).join(", ") %></p>
  <% end %>
</div>
<div class="tab-panel" id="tab-sell" role="tabpanel">
  <% sellable = inventory.select { |entry| entry[:quantity].positive? } %>
  <% if sellable.any? %>
    <ul class="mart">
      <% sellable.each do |entry| %>
        <% sell_item = ItemCatalog.find(entry[:name]) %>
        <li>
          <span class="mart-name"><span class="item-icon" aria-hidden="true"><%= (sell_item&.display_name || entry[:name])[0] %></span><span><strong><%= sell_item&.display_name || entry[:name] %></strong> <span class="meta">×<%= entry[:quantity] %></span></span></span>
          <span class="row"><span class="num price"><%= sell_item ? "¥#{sell_item.price / 2}" : "—" %></span>
            <form hx-post="/mart/sell" hx-target="#team-view" hx-swap="innerHTML">
              <input type="hidden" name="item_name" value="<%= entry[:name] %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="btn btn-ghost btn-sm">Vender</button>
            </form>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="inventory-empty">Nenhum item no estoque para vender.</p>
  <% end %>
</div>
