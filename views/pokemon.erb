<form
    hx-post="/team"
    hx-target="#team"
    hx-swap="innerHTML">
  <div>
    <a href="#" hx-get="/pokemon/<%= @pokemon.number %>" hx-target="#pokemon" hx-swap="innerHTML">
      <%= @pokemon.name %>
    </a><br>
    <input type="image" src=<%= @pokemon.sprite %>>
    <input type="hidden" name="pokeName" value=<%= @pokemon.name %>>
  </div>
  <button class="btn">Add to Team</button>
</form>
