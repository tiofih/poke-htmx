<form
    hx-post="/team"
    hx-target="#add-status"
    hx-swap="innerHTML">
  <div>
    <a href="#" hx-get="/pokemon/<%= @pokemon.number %>" hx-target="#pokemon-detail" hx-swap="innerHTML">
      <%= @pokemon.name %>
    </a><br>
    <a href="#" hx-get="/pokemon/<%= @pokemon.number %>" hx-target="#pokemon-detail" hx-swap="innerHTML">
      <img src="<%= @pokemon.sprite %>" alt="<%= @pokemon.name %>">
    </a><br>
    <input type="hidden" name="pokeName" value=<%= @pokemon.name %>>
  </div>
  <button class="btn">Adicionar ao time</button>
</form>
