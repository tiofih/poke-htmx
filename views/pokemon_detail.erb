<img src="<%= @pokemon.sprite %>" alt="<%= @pokemon.name %>">
<%= @pokemon.name %><br>
<% @pokemon.types.each do |type| %>
  <span class="type"><%= type %></span>
<% end %><br>
<ul class="stats">
  <% @pokemon.stats.each do |stat| %>
    <li><%= stat[:name] %>: <%= stat[:value] %></li>
  <% end %>
</ul>
<% unless @pokemon.evolutions.empty? %>
  <ul class="evolutions">
    <% @pokemon.evolutions.each do |evolution| %>
      <li class="evolution">
        <img src="<%= evolution.sprite %>" alt="<%= evolution.name %>" loading="lazy">
        <%= evolution.name %>
      </li>
    <% end %>
  </ul>
<% end %>
<form
    hx-post="/team"
    hx-target="#team"
    hx-swap="innerHTML">
  <input type="hidden" name="pokeName" value="<%= @pokemon.name %>">
  <button class="btn">Add to Team</button>
</form>
<button
    class="btn"
    hx-get="/pokemon/close"
    hx-target="#pokemon"
    hx-swap="innerHTML">Fechar</button>
