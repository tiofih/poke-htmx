<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Poké-HTMX</title>
    <script src="https://unpkg.com/htmx.org@2.0.3"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sakura.css/css/sakura.css" type="text/css">
    <link rel="stylesheet" href="/style.css" type="text/css">
  </head>

  <body class="<%= "page-battle" if request.path == "/battle" %><%= " page-list" if request.path == "/" %><%= " page-history" if request.path == "/history" %>">
    <div id="global-loading" aria-hidden="true"></div>
    <header>
      <nav>
        <strong>Poké-HTMX</strong>
        <a href="/" class="<%= "active" if request.path == "/" %>">Lista <span class="nav-badge"><%= @team_size || 0 %>/6</span></a>
        <a href="/battle" class="<%= "active" if request.path == "/battle" %>">Batalha</a>
        <a href="/history" class="<%= "active" if request.path == "/history" %>">Histórico</a>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>
    <script>
      document.addEventListener("htmx:beforeRequest", function () {
        document.getElementById("global-loading").classList.add("active");
      });
      document.addEventListener("htmx:afterRequest", function () {
        document.getElementById("global-loading").classList.remove("active");
      });
      var htmxSavedScrollY = null;
      document.addEventListener("htmx:beforeRequest", function () {
        htmxSavedScrollY = window.scrollY;
      });
      document.addEventListener("htmx:afterSwap", function () {
        if (htmxSavedScrollY !== null) {
          window.scrollTo(0, htmxSavedScrollY);
          htmxSavedScrollY = null;
        }
      });
    </script>
  </body>
</html>