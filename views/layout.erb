<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Poké-HTMX</title>
    <script src="https://unpkg.com/htmx.org@2.0.3"></script>
    <link rel="stylesheet" href="/style.css" type="text/css">
  </head>

  <body class="<%= "page-battle" if request.path == "/battle" %><%= " page-list" if request.path == "/" %><%= " page-history" if request.path == "/history" %>">
    <div id="global-loading" aria-hidden="true"></div>
    <header class="topnav" data-od-id="topnav">
      <div class="container topnav-inner">
        <a href="/" class="logo">Poké-HTMX</a>
        <nav data-od-id="nav">
          <a href="/" class="<%= "active" if request.path == "/" %>"<%= ' aria-current="page"' if request.path == "/" %>>Time <span class="nav-badge num" id="nav-badge"><%= @team_size || 0 %>/6</span></a>
          <a href="/history" class="<%= "active" if request.path == "/history" %>"<%= ' aria-current="page"' if request.path == "/history" %>>Histórico</a>
        </nav>
        <a href="/battle" class="btn btn-primary" data-od-id="cta-battle">Batalhar</a>
        <% if request.path == "/battle" %>
          <a href="/" class="btn btn-secondary">◀ Voltar ao time</a>
        <% end %>
      </div>
    </header>

    <main id="content">
      <%= yield %>
    </main>

    <footer class="pagefoot" data-od-id="footer">
      <div class="container row-between">
        <span>© Poké-HTMX</span>
        <span class="meta">sprites oficiais PokéAPI</span>
      </div>
    </footer>
    <script>
      document.addEventListener("htmx:beforeRequest", function () {
        document.getElementById("global-loading").classList.add("active");
      });
      document.addEventListener("htmx:afterRequest", function () {
        document.getElementById("global-loading").classList.remove("active");
      });
      var htmxSavedScrollY = null;
      document.addEventListener("htmx:beforeRequest", function () {
        htmxSavedScrollY = window.scrollY;
      });
      document.addEventListener("htmx:afterSwap", function () {
        if (htmxSavedScrollY !== null) {
          window.scrollTo(0, htmxSavedScrollY);
          htmxSavedScrollY = null;
        }
      });
      // 0088 Passo 4 (D1a/D2a — excecao estreita ao RNF-01): projetil slot-a-slot.
      // O swap do golpe troca o conteudo de #jx-shot-track e #jx-gates por OOB;
      // "afterSettle" so dispara depois que o DOM assentou (OOB incluso), entao a
      // medida acontece com o .shot novo e o gate ja aceso. Le o slot do alvo no
      // proprio .shot, acha o card por data-side + data-slot e escreve o
      // deslocamento vertical em --fx-dy; o keyframe juice-shot-ltr/rtl consome a
      // var com fallback 0. No-op quando falta track/shot/slot, em reduced motion
      // ou em coluna unica (<981px, mesmo breakpoint do @container do CSS) — nesses
      // casos vale o rail de 0087 (so eixo x). Um handler, sem lib/polling/SSE.
      function placeShot() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!window.matchMedia("(min-width: 981px)").matches) return;
        var shot = document.querySelector("#jx-shot-track .shot");
        if (!shot) return;
        var from = shot.getAttribute("data-from-slot");
        var side = shot.getAttribute("data-to-side");
        var slot = shot.getAttribute("data-to-slot");
        if (from === null || side === null || slot === null) return;
        var target = document.querySelector('.fighter[data-side="' + side + '"][data-slot="' + slot + '"]');
        if (!target) return;
        var shotBox = shot.getBoundingClientRect();
        var targetBox = target.getBoundingClientRect();
        var dy = targetBox.top + targetBox.height / 2 - (shotBox.top + shotBox.height / 2);
        shot.style.setProperty("--fx-dy", dy + "px");
      }
      document.addEventListener("htmx:afterSettle", placeShot);
    </script>
  </body>
</html>
