<html>
  <head>
    <meta charset="UTF-8">
    <title>Poké-HTMX</title>
    <script src="https://unpkg.com/htmx.org@2.0.3"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sakura.css/css/sakura.css" type="text/css">
    <link rel="stylesheet" href="/style.css" type="text/css">
  </head>

  <body>
    <header>
      <nav>
        <strong>Poké-HTMX</strong>
        <a id="nav-lista" href="#pokemon-list" hx-get="/battle/close" hx-target="#battle" hx-swap="innerHTML">Lista</a>
        <a href="#team" hx-get="/team/manage" hx-target="#team" hx-swap="innerHTML">Time</a>
        <a href="#battle" hx-get="/battle" hx-target="#battle" hx-swap="innerHTML">Batalha</a>
        <a href="#history" hx-get="/history" hx-target="#history" hx-swap="innerHTML">Histórico</a>
        <span hx-get="/history/close" hx-target="#history" hx-swap="innerHTML" hx-trigger="click from:#nav-lista"> </span>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>
  </body>
</html>