<div id="mart-modal" class="overlay open">
  <div class="modal" role="dialog" aria-modal="true" aria-label="Poke Mart" data-od-id="modal-mart">
    <div class="modal-head">
      <h2>Poke Mart</h2>
      <button type="button" class="modal-close" aria-label="Fechar" data-od-id="modal-mart-close"
         hx-get="/team/mart/close" hx-target="#mart-modal" hx-swap="outerHTML">×</button>
    </div>
    <% if notice %>
      <p class="notice<%= " notice--#{notice_kind}" if notice_kind %>"><%= notice %></p>
    <% end %>
    <%= erb :_mart, layout: false, locals: { balance: balance, catalog: catalog, inventory: inventory, rotation: rotation } %>
  </div>
</div>
