<div id="center-modal" class="overlay open">
  <div class="modal" role="dialog" aria-modal="true" aria-label="Poke Center" data-od-id="modal-center">
    <div class="modal-head">
      <h2>Poke Center</h2>
      <button type="button" class="modal-close" aria-label="Fechar" data-od-id="modal-center-close"
         hx-get="/team/center/close" hx-target="#center-modal" hx-swap="outerHTML">×</button>
    </div>
    <% if @notice %>
      <p class="notice<%= " notice--#{@notice_kind}" if @notice_kind %>"><%= @notice %></p>
    <% end %>
    <%= erb :_center, layout: false %>
  </div>
</div>
