<% side_class = entry[:side] == "Seu Time" ? "team" : "opp" %>
<% fx_class = entry[:ko] ? "fx--ko" : (entry[:damage] ? "fx--hit" : (entry[:healed] ? "fx--heal" : "fx--tick")) %>
<li class="log__entry"
    style="--log-delay: 0s"
    data-round="<%= entry[:round] %>"
    data-from-side="<%= entry[:from_side] %>"
    data-to-side="<%= entry[:to_side] %>">
  <span class="fx <%= fx_class %>" style="--log-delay: 0s" aria-hidden="true"></span>
  <span class="lside <%= side_class %>"><%= entry[:side] %></span>
  <span class="txt"><strong><%= entry[:text] %></strong>
    <% if entry[:damage] %><span class="chip chip--dmg"><%= entry[:damage] %> de dano</span><% end %>
    <% if entry[:ko] %><span class="chip chip--ko">KO!</span><% end %>
    <% unless entry[:remaining].nil? %><span class="chip chip--stock">restam <%= entry[:remaining] %></span><% end %>
    <% if entry[:last_unit] %><span class="chip chip--empty">última unidade</span><% end %>
  </span>
</li>

