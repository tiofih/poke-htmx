<span class="shot-track" id="jx-shot-track"<% if defined?(oob) && oob %> hx-swap-oob="innerHTML"<% end %> aria-hidden="true"><% if shot %><span class="shot" data-from-side="<%= shot[:from_side] %>" data-to-side="<%= shot[:to_side] %>"<% if shot[:move_type] %> data-move-type="<%= shot[:move_type] %>"<% end %><% if shot[:from_slot] %> data-from-slot="<%= shot[:from_slot] %>"<% end %><% if shot[:to_slot] %> data-to-slot="<%= shot[:to_slot] %>"<% end %>></span><% end %></span>
