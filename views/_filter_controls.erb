<div class="field">
  <label for="fsearch">Buscar no arquivo</label>
  <input
    id="fsearch"
    type="text"
    name="q"
    class="filter-state input"
    aria-label="Buscar no arquivo"
    placeholder="Filtrar por nome"
    value="<%= @q %>"
    hx-target="#pokemon-list"
    hx-trigger="keyup changed delay:300ms"
    hx-get="/pokemons?offset=0"
    hx-swap="innerHTML"
    hx-include=".filter-state">
</div>

<span class="filter-count meta">Resultados · <%= @starters.size + @items.size %></span>

<div class="filter-grid">

<div class="field">
  <label for="filter-type">Tipo</label>
  <select id="filter-type" name="type" class="filter-state input" aria-label="Tipo" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @type.nil? %>>Todos os tipos</option>
    <% PokeApiTypes::TYPE_NAMES.each do |t| %>
      <option value="<%= t %>" <%= "selected" if @type == t %>><%= t.capitalize %></option>
    <% end %>
  </select>
</div>

<div class="field">
  <label for="filter-generation">Geração</label>
  <select id="filter-generation" name="generation" class="filter-state input" aria-label="Geração" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @generation.nil? %>>Todas as gerações</option>
    <% (1..9).each do |g| %>
      <option value="<%= g %>" <%= "selected" if @generation == g %>>Geração <%= g %></option>
    <% end %>
  </select>
</div>

<div class="field">
  <label for="filter-tier">Tier</label>
  <select id="filter-tier" name="tier" class="filter-state input" aria-label="Tier" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @tier.nil? %>>Todos os tiers</option>
    <% %w[S A B C D F].each do |t| %>
      <option value="<%= t %>" <%= "selected" if @tier == t %>><%= t %></option>
    <% end %>
  </select>
</div>

<div class="field">
  <label for="filter-cost_max">Custo máx</label>
  <select id="filter-cost_max" name="cost_max" class="filter-state input" aria-label="Custo máx" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @cost_max.nil? %>>Qualquer custo</option>
    <option value="20" <%= "selected" if @cost_max == 20 %>>≤ 20</option>
    <option value="30" <%= "selected" if @cost_max == 30 %>>≤ 30</option>
    <option value="40" <%= "selected" if @cost_max == 40 %>>≤ 40</option>
    <option value="55" <%= "selected" if @cost_max == 55 %>>≤ 55</option>
    <option value="70" <%= "selected" if @cost_max == 70 %>>≤ 70</option>
    <option value="120" <%= "selected" if @cost_max == 120 %>>≤ 120</option>
  </select>
</div>

<div class="field">
  <label for="filter-sort">Ordenação</label>
  <select id="filter-sort" name="sort" class="filter-state input" aria-label="Ordenação" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @sort.nil? %>>Padrão</option>
    <option value="cost_asc" <%= "selected" if @sort == "cost_asc" %>>Custo ↑</option>
    <option value="cost_desc" <%= "selected" if @sort == "cost_desc" %>>Custo ↓</option>
    <option value="tier_desc" <%= "selected" if @sort == "tier_desc" %>>Tier S→F</option>
    <option value="tier_asc" <%= "selected" if @sort == "tier_asc" %>>Tier F→S</option>
  </select>
</div>

<div class="field">
  <label for="filter-team">Disponibilidade</label>
  <select id="filter-team" name="team" class="filter-state input" aria-label="Disponibilidade" hx-get="/pokemons?offset=0" hx-target="#pokemon-list" hx-swap="innerHTML" hx-include=".filter-state" hx-trigger="change">
    <option value="" <%= "selected" if @team_filter.nil? %>>Todos</option>
    <option value="out" <%= "selected" if @team_filter == "out" %>>Fora do time</option>
    <option value="in" <%= "selected" if @team_filter == "in" %>>No time</option>
  </select>
</div>
</div>
