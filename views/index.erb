<section class="section">
  <div class="container">
    <div class="app-head row-between">
      <div>
        <p class="eyebrow">Seu time · Jornada</p>
        <h1>Monte o esquadrão, batalhe, avance.</h1>
      </div>
      <div class="budget-summary">
        <div class="budget-meta row">Custo do time <strong class="num"><%= @team_cost %>/<%= @team_budget %></strong></div>
        <div class="meter"><span class="meter-fill" style="width:<%= (@team_cost.to_f / @team_budget * 100) %>%"></span></div>
        <a class="btn btn-secondary" href="#" hx-get="/team/manage" hx-target="#team-view" hx-swap="innerHTML">Gerenciar time</a>
      </div>
    </div>

    <div class="grid-2-1">
      <div class="stack">
        <div id="team-view">
          <%= erb :team, layout: false %>
        </div>
        <div class="card services">
          <div class="row-between"><h2>Serviços</h2><span class="meta num">Saldo <%= @balance %></span></div>
          <div class="services-row">
            <!-- Serviços (Poke Center / Poke Mart) voltam na 0076, junto com as rotas de modal GET /team/center e GET /team/mart -->
          </div>
        </div>
      </div>
      <aside class="catalog-pane stack">
        <div class="card">
          <div id="filter-controls">
            <%= erb :_filter_controls, layout: false %>
          </div>
        </div>
        <div id="pokemon-list" class="catalog">
          <%= erb :pokemon_list, layout: false %>
        </div>
        <div id="add-status"></div>
        <div id="pokemon-detail"></div>
      </aside>
    </div>
  </div>
</section>
