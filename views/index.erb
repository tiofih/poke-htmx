<input
      type="text"
      name="q"
      placeholder="Filtrar por nome"
      hx-target="#pokemon-list"
      hx-trigger="keyup changed delay:300ms"
      hx-get="/pokemons"
      hx-swap="innerHTML">

    <div id="pokemon-list">
      <%= erb :pokemon_list, layout: false %>
    </div>

    <div id="pokemon"> </div>
    <div id="team" hx-get="/team" hx-trigger="load, teamRefresh from:body"> </div>
    <div id="battle"> </div>
    <div id="history"> </div>