<% if @notice %>
  <p class="notice<%= " notice--#{@notice_kind}" if @notice_kind %>"><%= @notice %></p>
<% end %>
<% unless @journey_started %>
  <p class="journey-progress">Time: <%= @team.size %>/6</p>
  <p class="notice notice--info">Monte seu time inicial de 6 Pokémon para iniciar a jornada.</p>
<% end %>
<% if @team_cost && @team_budget %>
  <p class="team-budget">Custo do time: <%= @team_cost %>/<%= @team_budget %></p>
<% end %>
<p class="team-tools">
  <a href="#" hx-get="/team/manage" hx-target="#team-view" hx-swap="innerHTML">Gerenciar time</a>
</p>
<% if @game_over %>
  <p class="notice notice--error">Game Over — seu time está derrotado e você não tem dinheiro para curar. Venda itens no Poke Mart ou recomece a jornada.</p>
  <form hx-post="/journey/restart" hx-target="#team-view" hx-swap="innerHTML" hx-include=".list-state">
    <button type="submit" class="gameloop-cta">Recomeçar jornada</button>
  </form>
<% end %>
<% if @journey_started %>
  <% unless @team.empty? %>
    <% if @can_battle %>
      <a class="gameloop-cta battle" href="/battle">Batalhar</a>
    <% end %>

    <%= erb :_center, layout: false %>

    <%= erb :_mart, layout: false %>
  <% end %>
<% end %>
<% @team.each do |poke| %>
  <p class="slot">#<%= poke.slot %></p>
  <img src="<%= poke.sprite %>" alt="<%= poke.name %>"><br>
  <strong><%= poke.name %></strong><br>
  <form
      hx-post="/team/<%= poke.id %>/move"
      hx-target="#team-view"
      hx-swap="innerHTML">
    <input type="hidden" name="new_slot" value="<%= poke.slot - 1 %>">
    <button type="submit" aria-label="Mover para cima">▲</button>
  </form>
  <form
      hx-post="/team/<%= poke.id %>/move"
      hx-target="#team-view"
      hx-swap="innerHTML">
    <input type="hidden" name="new_slot" value="<%= poke.slot + 1 %>">
    <button type="submit" aria-label="Mover para baixo">▼</button>
  </form>
  <!-- hx-params "*" garante id + list-state; hx-include ".list-state" explicita filtros (redundancia intencional) -->
  <form
      id='team-pokemon-<%= poke.id %>'
      hx-delete="/team"
      hx-target="#team-view"
      hx-swap="innerHTML"
      hx-include=".list-state"
      hx-params="*"
      hx-sync="closest form:replace"
      hx-indicator="#team-view">
    <input type="hidden" name="id" value="<%= poke.id %>">
    <button type="submit" class="btn" hx-disabled-elt="this">Remover do time</button>
  </form>
<% end %>
