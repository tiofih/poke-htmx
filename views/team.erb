<% @team.map.with_index do |poke, idx| %>
  <div id='team-pokemon-<%= idx %>'>
    <input type="image" src=<%= poke.sprite %>><br>
    <%= poke.name %><br>
    <input type="hidden" name="index" value=<%= idx %>>
    <button
        class="btn"
        hx-get="/team"
        hx-target="#team"
        hx-swap="innerHTML"
        hx-params="*">
      Remove from Team
    </button><br>
  </div>
<% end %>
