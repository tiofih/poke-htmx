<% if @notice %>
  <p class="notice<%= " notice--#{@notice_kind}" if @notice_kind %>"><%= @notice %></p>
<% end %>
<% unless @journey_started %>
  <p class="journey-progress">Time: <%= @team.size %>/6</p>
  <p class="notice notice--info">Monte seu time inicial de 6 Pokémon para iniciar a jornada.</p>
<% end %>
<% if @team_cost && @team_budget %>
  <p class="team-budget">Custo do time: <%= @team_cost %>/<%= @team_budget %></p>
<% end %>
<% if @game_over %>
  <p class="notice notice--error">Game Over — seu time está derrotado e você não tem dinheiro para curar. Venda itens no Poke Mart ou recomece a jornada.</p>
  <form hx-post="/journey/restart" hx-target="#team-view" hx-swap="innerHTML" hx-include=".list-state">
    <button type="submit" class="btn btn-secondary">Recomeçar jornada</button>
  </form>
<% end %>
<% if @journey_started %>
  <% unless @team.empty? %>
    <% if @can_battle %>
      <a class="gameloop-cta battle" href="/battle">Batalhar</a>
    <% end %>

    <h2>Poke Center</h2>
    <%= erb :_center, layout: false %>

    <h2>Poke Mart</h2>
    <%= erb :_mart, layout: false %>
  <% end %>
<% end %>
<div class="card">
  <div class="row-between">
    <h2>Seu time</h2>
    <span class="pill<%= " warn" if @journey_started && @can_battle == false %><%= " danger" if @game_over %>" id="readiness-pill">
      <%= @game_over ? "Game over" : (@can_battle ? "Pronto p/ batalhar" : "Precisa de cura") %>
    </span>
  </div>
  <ul class="roster" data-od-id="members">
    <% @team.each do |poke| %>
      <li class="member">
        <div class="member-top">
          <div class="sprite-tile"><img src="<%= poke.sprite %>" alt="<%= poke.name %>" width="96" height="96"></div>
          <div>
            <span class="slot">#<%= poke.slot %></span>
            <span class="member-name"><%= poke.name %></span>
            <% member_types = @team_types && @team_types[poke.id] %>
            <% unless member_types.nil? || member_types.empty? %>
              <span class="mtags">
                <% member_types.each do |tag| %><span class="mtag mtag--<%= tag %>"><%= tag %></span><% end %>
              </span>
            <% end %>
          </div>
        </div>
        <div class="hp">
          <span class="hp-label">HP</span>
          <span class="bar"><span class="bar-fill" style="width:<%= poke.hp_max.to_i.positive? ? (poke.hp_current.to_f / poke.hp_max.to_f * 100).round : 0 %>%"></span></span>
          <span class="num hp-val"><%= poke.hp_current %>/<%= poke.hp_max %></span>
        </div>
        <div class="member-actions">
          <a class="btn evolution-trigger" href="#evolution-modal"
             hx-get="/team/<%= poke.id %>/evolution" hx-target="body" hx-swap="beforeend"<%= ' disabled title="Pokémon derrotado — cure antes de evoluir"' if poke.fainted? %>>Evoluir</a>
          <form
              hx-post="/team/<%= poke.id %>/move"
              hx-target="#team-view"
              hx-swap="innerHTML">
            <input type="hidden" name="new_slot" value="<%= poke.slot - 1 %>">
            <button type="submit" aria-label="Mover para cima">▲</button>
          </form>
          <form
              hx-post="/team/<%= poke.id %>/move"
              hx-target="#team-view"
              hx-swap="innerHTML">
            <input type="hidden" name="new_slot" value="<%= poke.slot + 1 %>">
            <button type="submit" aria-label="Mover para baixo">▼</button>
          </form>
          <!-- hx-params "*" garante id + list-state; hx-include ".list-state" explícita filtros (redundância intencional) -->
          <form
              id='team-pokemon-<%= poke.id %>'
              hx-delete="/team"
              hx-target="#team-view"
              hx-swap="innerHTML"
              hx-include=".list-state"
              hx-params="*"
              hx-sync="closest form:replace"
              hx-indicator="#team-view">
            <input type="hidden" name="id" value="<%= poke.id %>">
            <button type="submit" class="btn" hx-disabled-elt="this"<%= ' disabled title="Pokémon derrotado — cure antes de remover"' if poke.fainted? %>>Remover do time</button>
          </form>
        </div>
      </li>
    <% end %>
  </ul>
</div>
